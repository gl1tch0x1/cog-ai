# ═══════════════════════════════════════════════════════════════════════════
# SecAgent Environment Configuration
# Copy to .env and fill in values. NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════════════

# ── Universal LLM Keys (comma-separated, auto-detects provider by prefix) ──
# Supports: OpenAI (sk-), Anthropic (sk-ant-), Groq (gsk_), Google (AIza), OpenRouter (sk-or-)
LLM_API_KEYS=sk-...,sk-ant-...

# Or set individual provider keys:
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...
DEEPSEEK_API_KEY=sk-...
GEMINI_API_KEY=AIza...
OPENROUTER_API_KEY=sk-or-...
XAI_API_KEY=xai-...

# OpenAI-compatible custom endpoint (optional)
OPENAI_BASE_URL=https://api.openai.com/v1

# Local LLM (offline mode)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ── External Intelligence ───────────────────────────────────────────────────
SHODAN_API_KEY=
CHAOS_API_KEY=

# ── Database & Queue ──────────────────────────────────────────────────────
DB_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://secagents:changeme@localhost:5432/secagents
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=secagents_redis

# ── Authentication ────────────────────────────────────────────────────────
JWT_SECRET=generate_a_long_random_string_here

# ── CORS (comma-separated origins allowed by the API) ─────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Scope Control (REQUIRED — enforced on every scan) ─────────────────────
ALLOWED_DOMAINS=example.com,*.example.com
BLOCKED_DOMAINS=

# ── Performance ───────────────────────────────────────────────────────────
MAX_SCAN_DEPTH=3
MAX_CONCURRENT_AGENTS=4

# ── Integrations (Optional) ───────────────────────────────────────────────
SLACK_WEBHOOK_URL=
JIRA_URL=
JIRA_API_TOKEN=
JIRA_PROJECT=SEC
GITHUB_TOKEN=

# ── OAST / Out-of-band ────────────────────────────────────────────────────
INTERACTSH_SERVER=

# ── SecAgent Platform ─────────────────────────────────────────────────────
SECAGENT_GITHUB_REPO=gl1tch0x1/cog-ai
RESULTS_DIR=./cog-ai-results
